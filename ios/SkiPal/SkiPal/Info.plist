<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    <!-- 联系人权限 (紧急联系人) -->
    <key>NSContactsUsageDescription</key>
    <string>SkiPal 需要访问联系人来选择紧急联系人。</string>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
        <string>gps</string>
        <string>location-services</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    
    <!-- 定位权限描述 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>SkiPal 需要您的位置来记录滑雪轨迹和计算速度、距离等数据。</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>SkiPal 需要后台定位权限，以便在滑雪时持续记录您的轨迹（即使App在后台）。</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>SkiPal 需要后台定位来完整记录您的滑雪轨迹。</string>
    
    <!-- 运动健身权限 -->
    <key>NSMotionUsageDescription</key>
    <string>SkiPal 使用运动传感器来优化滑雪检测。</string>

    <!-- 相机和麦克风权限 (视频录制) -->
    <key>NSCameraUsageDescription</key>
    <string>SkiPal 需要访问摄像头来录制滑雪视频，记录您的精彩瞬间。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>SkiPal 需要访问麦克风来录制视频中的音频。</string>

    <!-- 照片库权限 (保存视频) -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>SkiPal 需要访问相册来查看和分享您的滑雪视频。</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>SkiPal 需要保存滑雪视频到相册。</string>

    <!-- 通知权限 (跌倒警报) -->
    <key>NSUserNotificationsUsageDescription</key>
    <string>SkiPal 需要发送通知来提醒您跌倒检测警报和紧急情况。</string>

    <!-- iCloud 容器标识 (CloudKit 同步) -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.skiPal.app</string>
    </array>

    <!-- 后台模式 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>audio</string>
        <string>processing</string>
    </array>
    <!-- 联系人权限 (紧急联系人) -->
    <key>NSContactsUsageDescription</key>
    <string>SkiPal 需要访问联系人来选择紧急联系人。</string>
</dict>
</plist>
